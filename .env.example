# Required: add your Mistral API key.
MISTRAL_API_KEY=

# Recommended: add your Apify token for public-profile scraping.
APIFY_TOKEN=

# Optional model and API overrides.
MISTRAL_MODEL=mistral-large-latest
MISTRAL_DATE_MODEL=mistral-medium-latest
MISTRAL_BASE_URL=https://api.mistral.ai

# Public-profile scraping actors.
APIFY_INSTAGRAM_ACTOR=apify/instagram-profile-scraper
APIFY_LINKEDIN_ACTOR=harvestapi/linkedin-profile-scraper
